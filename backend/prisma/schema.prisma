generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String        @id @default(uuid())
  sku         String        @unique
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  inventory   Inventory[]
  transactions Transaction[]
}

model Warehouse {
  id          String        @id @default(uuid())
  code        String        @unique // e.g., DEL-01
  name        String
  location    String
  capacity    Int           @default(100) // Percentage or max units
  suppliers   Supplier[]
  users     User[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  inventory   Inventory[]
  transactions Transaction[]
}

model Inventory {
  id          String    @id @default(uuid())
  quantity    Int       @default(0)
  lastSync    DateTime  @updatedAt

  // Foreign Keys
  productId   String
  warehouseId String
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // CRITICAL: Prevents duplicate inventory tracking records
  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// Immutable Audit Ledger for all stock movements
model Transaction {
  id          String    @id @default(uuid())
  type        TxType
  quantity    Int       // Positive for inbound, negative for outbound
  reference   String?   // e.g., Order ID, Batch ID, or Receipt Number
  timestamp   DateTime  @default(now())

  // Foreign Keys
  productId   String
  warehouseId String

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([timestamp])
}

enum TxType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
}
// The Dynamic Role Engine
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., 'GLOBAL_ADMIN', 'NODE_MANAGER', 'INBOUND_SPECIALIST', etc.
  permissions String[]
  users       User[]
}

model User {
  id          String     @id @default(uuid())
  googleId    String?    @unique
  email       String     @unique
  name        String
  avatar      String?
  status      UserStatus @default(PENDING) // <--- NEW: Locks out new signups
  roleId      String
  role        Role       @relation(fields: [roleId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}
model JobQueue {
  id        String   @id @default(uuid())
  taskType  String   // e.g., 'GENERATE_TICKET'
  payload   Json     // Stores the SKU, warehouse, and quantity
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Supplier {
  id          String      @id @default(uuid())
  name        String
  code        String
  contact     String
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
}